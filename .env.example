# Comma-separated OpenRouter key pool (at least 1). Ids are key_1, key_2, ...
LLM_API_KEYS=sk-or-v1-your-key-1,sk-or-v1-your-key-2
# SQLite file; /data is the Docker named volume
DATABASE_URL=sqlite:////data/flowai.db
# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# LiteLLM model name — "openrouter/" prefix + OpenRouter model id
LLM_MODEL=openrouter/google/gemini-flash-lite
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
# Frontend build-time API URL (browser-visible backend URL)
VITE_API_URL=http://localhost:8000
